# Copy to .env and fill in real values for your local environment.
# Never commit a real .env file.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL (see infrastructure/docker-compose.yml for local defaults)
DATABASE_URL=postgresql://xnakview:xnakview_dev_password@localhost:5432/xnakview_dev?schema=public

# REQUIRED to run `npm test` — a completely separate database from
# DATABASE_URL above (never the same value, and its name must contain
# "test"). Tests refuse to run and never touch DATABASE_URL if this is
# missing or equal to it — see src/test/dbGuard.ts / env.setup.ts.
TEST_DATABASE_URL=postgresql://xnakview:xnakview_dev_password@localhost:5432/xnakview_test?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Optional but recommended: a separate Redis logical DB index for tests, so
# `redis.flushdb()` in the test suite never wipes dev session/rate-limit
# data. If unset, tests fall back to REDIS_URL's database.
TEST_REDIS_URL=redis://localhost:6379/1

# JWT secrets — generate with `openssl rand -hex 64` (min 32 chars, longer is better).
# These are placeholders only. Replace before running anything beyond local dev.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

LOG_LEVEL=info

# Video storage — "local" writes under STORAGE_LOCAL_DIR (relative to the
# backend process's cwd). Swapping to object storage later only means
# adding a new StorageDriver implementation in lib/storage — nothing else
# in the codebase touches the filesystem directly.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
MAX_UPLOAD_BYTES=209715200

# Must be installed and on PATH (or point these at absolute paths).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# LIVE streaming — self-hosted LiveKit (see infrastructure/docker-compose.yml).
# These placeholder dev keys match the compose file's `--keys` value; replace
# both with real generated values (`docker run --rm livekit/livekit-server
# generate-keys`) before running anywhere beyond local development.
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret32characterslongforlocaldev

# Chat + calls (Step 5) — all have sane defaults; override only to change
# product policy, not because a value is secret.
MAX_VOICE_MESSAGE_SECONDS=120
CALL_RING_TIMEOUT_SECONDS=45
MESSAGE_UNSEND_WINDOW_MINUTES=1440

# Real OTP delivery (signup/login verification codes) — leave both unset in
# local dev; SMS/email OTP requests then honestly refuse with a clear
# "not configured" error instead of pretending a code was sent
# (see lib/otpProviders.ts). Fill in real values to test actual delivery.
# Twilio SMS (fetch-based REST call, no SDK):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Any standard SMTP account (Gmail app password, Mailtrap, a real provider's
# SMTP relay, etc):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
OTP_CODE_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Coins & Gifts (Step 7) — the locked 1 Coin = PKR 1.50 rate lives in code,
# never here. Leave the App Store/Google Play/Web payment secrets unset in
# local dev; those providers then honestly refuse to verify a receipt
# rather than faking success (see lib/paymentProviders.ts).
WITHDRAWAL_MIN_AMOUNT_MINOR_UNITS=5000
# APPLE_SHARED_SECRET=
# GOOGLE_PLAY_PACKAGE_NAME=
# GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
# WEB_PAYMENT_WEBHOOK_SECRET=

# Step 8: Creator Monetization — real ad-revenue webhook (lib/adRevenueService.ts).
# Leave unset in local dev; the webhook then honestly refuses rather than
# trusting an unsigned ad-revenue report.
# AD_REVENUE_WEBHOOK_SECRET=

# Step 9: Automated global creator payouts — real Airwallex integration
# (lib/payout/airwallexClient.ts). Leave unset in local dev; the payout and
# identity-verification providers then honestly report "unavailable" rather
# than faking a PAID withdrawal or a VERIFIED identity.
AIRWALLEX_ENV=demo
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
# AIRWALLEX_WEBHOOK_SECRET=
# AIRWALLEX_KYC_CLIENT_ID=
# AIRWALLEX_KYC_API_KEY=

# Step 9: Payoneer White-Label Registration & Payouts
# (lib/payout/payoneerClient.ts) — REQUIRES a real Payoneer
# Partnerships/Compliance approval before these credentials exist; not
# self-service. Leave unset in local dev.
PAYONEER_ENV=sandbox
# PAYONEER_CLIENT_ID=
# PAYONEER_CLIENT_SECRET=
# PAYONEER_PROGRAM_ID=
# PAYONEER_WEBHOOK_SECRET=

# Step 10: AI Trust & Safety — text + image moderation via OpenAI's
# Moderation API (lib/moderation/openAiModerationClient.ts). Leave unset in
# local dev; without it, text/image moderation honestly reports
# "unavailable" rather than faking a "safe" result.
# OPENAI_MODERATION_API_KEY=

# Real licensed music catalog (Epidemic Sound Partner Content API —
# lib/epidemicSound.ts). Leave unset in local dev; without it, the Sound
# picker's Trending/Search tabs honestly report "unavailable" rather than
# faking a track catalog.
# EPIDEMIC_SOUND_API_KEY=
