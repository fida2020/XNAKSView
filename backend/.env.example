# Copy to .env and fill in real values for your local environment.
# Never commit a real .env file.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL (see infrastructure/docker-compose.yml for local defaults)
DATABASE_URL=postgresql://xnakview:xnakview_dev_password@localhost:5432/xnakview_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT secrets — generate with `openssl rand -hex 64` (min 32 chars, longer is better).
# These are placeholders only. Replace before running anything beyond local dev.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

LOG_LEVEL=info

# Video storage — "local" writes under STORAGE_LOCAL_DIR (relative to the
# backend process's cwd). Swapping to object storage later only means
# adding a new StorageDriver implementation in lib/storage — nothing else
# in the codebase touches the filesystem directly.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
MAX_UPLOAD_BYTES=209715200

# Must be installed and on PATH (or point these at absolute paths).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# LIVE streaming — self-hosted LiveKit (see infrastructure/docker-compose.yml).
# These placeholder dev keys match the compose file's `--keys` value; replace
# both with real generated values (`docker run --rm livekit/livekit-server
# generate-keys`) before running anywhere beyond local development.
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret32characterslongforlocaldev
