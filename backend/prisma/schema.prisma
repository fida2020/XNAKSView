// XNAKView schema — Step 1 (identity/foundation) + Step 3 (video platform).
// Future domains (LIVE, Match, Message, Wallet, Coins, Gifts, Withdrawals,
// Moderation, Levels, Teams, ...) will be added in later phases as their own
// models, relating back to User/Video via foreign keys, without needing to
// change what's defined here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum VerificationType {
  EMAIL
  PHONE
  IDENTITY_DOCUMENT
  AGE
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
  DESKTOP
}

model User {
  id           String  @id @default(uuid())
  email        String? @unique
  phone        String? @unique
  passwordHash String

  dateOfBirth DateTime?
  ageVerified Boolean   @default(false)

  status UserStatus @default(PENDING_VERIFICATION)

  // Minimal admin-role foundation (Step 4): a boolean flag, not a full RBAC
  // system — deliberately so. There is no self-serve way to become an admin;
  // an operator sets this directly in the database. `requireAdmin` (see
  // middleware/requireAdmin.ts) is the only thing that reads it.
  isAdmin Boolean @default(false)

  // Enforcement audit trail — who last changed `status` and why, and when.
  // Populated by lib/accountEnforcement.ts, which is the one place `status`
  // should ever be written outside of registration. Plain string ids (no
  // relation), matching the existing `assignedById`/`invitedById` convention
  // used elsewhere in this schema.
  statusReason      String?
  statusUpdatedAt   DateTime?
  statusUpdatedById String?

  // Presence (Step 5). This is a durable fallback ("last seen X ago"), not
  // the live "online right now" signal — that lives in Redis (see
  // lib/realtime.ts) because it changes far too often to be worth a DB
  // write per heartbeat. Updated on socket connect/disconnect.
  lastActiveAt DateTime?

  // Denormalized so profile/feed reads never need a COUNT() query.
  // Maintained transactionally alongside the Follow rows that back them.
  followerCount  Int @default(0)
  followingCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       Profile?
  verifications Verification[]
  devices       Device[]
  sessions      Session[]

  videos        Video[]
  videoLikes    VideoLike[]
  videoComments VideoComment[]
  videoViews    VideoView[]
  videoReports  VideoReport[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  liveSessions             LiveSession[]
  liveViewerships          LiveViewer[]
  liveChatMessages         LiveChatMessage[]
  liveReports              LiveReport[]
  liveEvents               LiveEvent[]
  liveEventReminders       LiveEventReminder[]
  liveModeratorOf          LiveModerator[]
  liveRestrictions         LiveViewerRestriction[]
  liveGuestSlots           LiveGuestSlot[]
  liveViewerReports        LiveViewerReport[]      @relation("LiveViewerReportReporter")
  liveViewerReportsAgainst LiveViewerReport[]      @relation("LiveViewerReportTarget")
  liveChatMessageReports   LiveChatMessageReport[]
  creatorSubscriptions     LiveSubscription[]      @relation("CreatorSubscriptions")
  fanSubscriptions         LiveSubscription[]      @relation("FanSubscriptions")

  conversationsAsOne  Conversation[]            @relation("ConversationParticipantOne")
  conversationsAsTwo  Conversation[]            @relation("ConversationParticipantTwo")
  conversationsInited Conversation[]            @relation("ConversationInitiator")
  conversationMembers ConversationParticipant[]
  messages            Message[]
  messageReceipts     MessageReceipt[]
  messageReports      MessageReport[]
  conversationReports ConversationReport[]
  blocksMade          UserBlock[]               @relation("BlockedByMe")
  blocksReceived      UserBlock[]               @relation("BlockedAgainstMe")
  messagingSettings   MessagingPrivacySettings?
  callsMade           Call[]                    @relation("CallsAsCaller")
  callsReceived       Call[]                    @relation("CallsAsCallee")
  callReports         CallReport[]

  mentionsMade     Mention[]              @relation("MentionsMade")
  mentionsReceived Mention[]              @relation("MentionsReceived")
  reposts          Repost[]
  favorites        Favorite[]
  commentLikes     VideoCommentLike[]
  commentReports   VideoCommentReport[]
  activityReceived ActivityNotification[] @relation("ActivityRecipient")
  activitySent     ActivityNotification[] @relation("ActivityActor")
  recentSearches   RecentSearch[]
  creatorPlaylists CreatorPlaylist[]

  photoPosts        PhotoPost[]
  photoPostLikes    PhotoPostLike[]
  photoPostComments PhotoPostComment[]
  photoPostReports  PhotoPostReport[]

  textPosts        TextPost[]
  textPostLikes    TextPostLike[]
  textPostComments TextPostComment[]
  textPostReports  TextPostReport[]

  stories      Story[]
  storyViews   StoryView[]
  storyReplies StoryReply[]
  storyReports StoryReport[]

  @@index([status])
  @@map("users")
}

model Profile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  username    String  @unique
  displayName String?
  bio         String?
  avatarUrl   String?

  country String?
  city    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
  @@map("profiles")
}

model Verification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status           VerificationStatus @default(PENDING)
  verificationType VerificationType

  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, verificationType])
  @@index([status])
  @@map("verifications")
}

model Device {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceIdentifier String
  platform         DevicePlatform

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  sessions Session[]

  @@unique([userId, deviceIdentifier])
  @@index([deviceIdentifier])
  @@map("devices")
}

model Session {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  refreshTokenHash String @unique

  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@index([deviceId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Video platform (Step 3)
// ---------------------------------------------------------------------------

enum VideoStatus {
  PROCESSING
  READY
  FAILED
  DELETED
}

enum VideoVisibility {
  PUBLIC
  PRIVATE
}

// Reused as the single canonical report-reason taxonomy across video, LIVE,
// messaging, and calls — not video-specific despite the name (kept for
// backward compatibility with the Step 3 migration that created it;
// renaming a live enum is a bigger migration than the value itself is
// worth).
enum VideoReportReason {
  SPAM
  NUDITY_OR_SEXUAL_CONTENT
  VIOLENCE
  HARASSMENT_OR_BULLYING
  HATE_SPEECH
  MISINFORMATION
  OTHER
}

enum VideoReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

model Video {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  caption String?

  // Storage keys, not URLs — resolved to an actual URL/path through the
  // storage abstraction (lib/storage) at read time, so switching from local
  // disk to object storage/CDN later never touches these rows.
  originalKey  String
  playbackKey  String?
  thumbnailKey String?

  durationMs Int?
  width      Int?
  height     Int?

  status          VideoStatus     @default(PROCESSING)
  visibility      VideoVisibility @default(PUBLIC)
  processingError String?

  // Creator-controlled content-reuse permissions (Step 6) — checked
  // server-side on every Duet/Stitch/download attempt, never trusted from
  // the client. Default true matches TikTok's default-on posture.
  allowDuet     Boolean @default(true)
  allowStitch   Boolean @default(true)
  allowDownload Boolean @default(true)

  // Duet/Stitch lineage — a Duet/Stitch is an ordinary Video row that also
  // points back at the video it was made from, rather than a separate
  // content type. `onDelete: SetNull` so deleting the source doesn't
  // cascade-delete every Duet/Stitch made from it (source-deletion
  // handling, brief D/E) — the derived video just loses its back-link.
  duetOfVideoId String?
  duetOfVideo   Video?  @relation("VideoDuets", fields: [duetOfVideoId], references: [id], onDelete: SetNull)
  duets         Video[] @relation("VideoDuets")

  stitchOfVideoId     String?
  stitchOfVideo       Video?  @relation("VideoStitches", fields: [stitchOfVideoId], references: [id], onDelete: SetNull)
  stitches            Video[] @relation("VideoStitches")
  stitchSourceStartMs Int?
  stitchSourceEndMs   Int?

  // Add Yours (brief G) — a video that carries a prompt (e.g. "your
  // favorite summer memory") that other users respond to with their own
  // video. Same lineage shape as Duet/Stitch: the response just points back
  // at the prompt video, it isn't a separate content type.
  addYoursPrompt    String?
  addYoursOfVideoId String?
  addYoursOfVideo   Video?  @relation("VideoAddYours", fields: [addYoursOfVideoId], references: [id], onDelete: SetNull)
  addYoursResponses Video[] @relation("VideoAddYours")

  // Sounds foundation (brief C) — every video's own audio is implicitly a
  // usable Sound (extracted lazily, see lib/sounds.ts); `soundId` records
  // which Sound this video was actually posted with (its own, or someone
  // else's) for the "use this sound" flow and the sound's usage count.
  soundId  String?
  sound    Sound?  @relation("VideosUsingSound", fields: [soundId], references: [id], onDelete: SetNull)
  ownSound Sound?  @relation("SoundSource")

  // Denormalized counters, maintained transactionally with their owning
  // rows (VideoLike, VideoComment, VideoView) or incremented directly
  // (shares have no dedicated table — see docs/STEP3_PROGRESS.md) so the
  // feed and video-detail reads never need a COUNT() aggregate.
  likeCount    Int @default(0)
  commentCount Int @default(0)
  viewCount    Int @default(0)
  shareCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    VideoLike[]
  comments VideoComment[]
  views    VideoView[]
  reports  VideoReport[]

  hashtags              VideoHashtag[]
  mentions              Mention[]
  reposts               Repost[]
  favorites             Favorite[]
  playlistItems         CreatorPlaylistItem[]
  activityNotifications ActivityNotification[]

  @@index([userId, status, createdAt])
  @@index([status, visibility, createdAt])
  @@index([duetOfVideoId])
  @@index([stitchOfVideoId])
  @@index([addYoursOfVideoId])
  @@index([soundId])
  @@map("videos")
}

model VideoLike {
  id String @id @default(uuid())

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([videoId, userId])
  @@index([userId])
  @@map("video_likes")
}

model VideoComment {
  id String @id @default(uuid())

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text String

  // One level of replies only (matching current TikTok behavior — a reply
  // cannot itself be replied to as a further-nested thread); enforced in
  // routes/v1/videos.ts, not just by this relation shape.
  parentId String?
  parent   VideoComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  VideoComment[] @relation("CommentReplies")

  // Denormalized so the comment list and detail view never need a COUNT()
  // aggregate, maintained transactionally alongside VideoCommentLike/reply
  // creation — same pattern as Video's own like/comment/view/share counters.
  likeCount  Int @default(0)
  replyCount Int @default(0)

  // Only the video owner may pin (checked in the route, not here); at most
  // one pinned comment per video is enforced in the route, matching current
  // TikTok behavior, not by a DB constraint (a second pin should replace
  // the first, not fail).
  pinnedAt DateTime?

  createdAt DateTime @default(now())

  likes                VideoCommentLike[]
  reports              VideoCommentReport[]
  ActivityNotification ActivityNotification[]

  @@index([videoId, createdAt])
  @@index([videoId, parentId, createdAt])
  @@index([userId])
  @@map("video_comments")
}

model VideoCommentLike {
  id String @id @default(uuid())

  commentId String
  comment   VideoComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
  @@map("video_comment_likes")
}

model VideoCommentReport {
  id String @id @default(uuid())

  commentId   String
  comment     VideoComment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason      VideoReportReason
  description String?
  status      VideoReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([commentId, reporterId])
  @@index([commentId])
  @@index([status])
  @@map("video_comment_reports")
}

model VideoView {
  id String @id @default(uuid())

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([videoId, createdAt])
  @@index([userId])
  @@map("video_views")
}

model Follow {
  id String @id @default(uuid())

  followerId  String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model VideoReport {
  id String @id @default(uuid())

  videoId     String
  video       Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason      VideoReportReason
  description String?
  status      VideoReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One report per user per video — enforced at the database level so
  // "prevent duplicate report spam" can't be bypassed by a race condition.
  @@unique([videoId, reporterId])
  @@index([videoId])
  @@index([status])
  @@map("video_reports")
}

// ---------------------------------------------------------------------------
// LIVE streaming (Step 4)
// ---------------------------------------------------------------------------

enum LiveStatus {
  LIVE
  ENDED
}

// Recording ("replay") of a finished LIVE session. NONE means the host
// didn't request one; the rest of the lifecycle exists so the API can
// express real states even though the recording pipeline itself (LiveKit
// Egress) is not deployed in Step 4 — see docs/STEP4_PROGRESS.md.
enum LiveReplayStatus {
  NONE
  NOT_AVAILABLE
  PROCESSING
  AVAILABLE
  DELETED
}

model LiveSession {
  id String @id @default(uuid())

  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  title    String
  category String?

  // Storage key (same convention as Video), resolved through the storage
  // abstraction — a thumbnail is optional; LIVE can start without one.
  thumbnailKey String?

  status LiveStatus @default(LIVE)

  // Denormalized, maintained transactionally by join/leave — see
  // lib/liveViewers.ts. Tracks explicit join/leave API calls (the client's
  // stated intent to view), not raw WebRTC connection state — see
  // docs/STEP4_PROGRESS.md for why, and what a fuller reconciliation would add.
  viewerCount     Int @default(0)
  peakViewerCount Int @default(0)

  // Co-host / multi-guest foundation (Step 4): how many non-host
  // participants may hold an ACTIVE LiveGuestSlot at once. Defaults to the
  // classic single co-host; raising it is what "multi-guest" means here —
  // no schema change needed to support more slots later.
  maxGuestSlots Int @default(1)

  // Subscriber-only chat foundation — the flag exists and is enforced by
  // the chat route, but nothing can set a LiveSubscription to ACTIVE yet
  // without a payment flow (a later monetization step), so this is
  // functional but practically always off until that exists.
  subscriberOnlyChat Boolean @default(false)

  // LIVE replay foundation — see LiveReplayStatus above.
  replayEnabled Boolean          @default(false)
  replayStatus  LiveReplayStatus @default(NONE)
  replayKey     String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  viewers       LiveViewer[]
  chatMessages  LiveChatMessage[]
  reports       LiveReport[]
  viewerReports LiveViewerReport[]
  event         LiveEvent?
  moderators    LiveModerator[]
  restrictions  LiveViewerRestriction[]
  guestSlots    LiveGuestSlot[]
  matchesAsA    LiveMatch[]             @relation("MatchSessionA")
  matchesAsB    LiveMatch[]             @relation("MatchSessionB")

  @@index([status, startedAt])
  @@index([hostId])
  @@map("live_sessions")
}

model LiveViewer {
  id String @id @default(uuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per (session, user) for the session's whole lifetime — rejoining
  // updates this row (joinedAt reset, leftAt cleared) rather than inserting a
  // new one. `leftAt IS NULL` is "currently watching"; the unique constraint
  // is what makes "duplicate join protection" a database guarantee (a second
  // concurrent join request can't create a second active row) rather than an
  // application-level race.
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([liveSessionId, userId])
  @@index([liveSessionId])
  @@map("live_viewers")
}

model LiveChatMessage {
  id String @id @default(uuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  text String

  createdAt DateTime @default(now())

  reports LiveChatMessageReport[]

  @@index([liveSessionId, createdAt])
  @@map("live_chat_messages")
}

model LiveReport {
  id String @id @default(uuid())

  liveSessionId String
  liveSession   LiveSession       @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  reporterId    String
  reporter      User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason        VideoReportReason
  description   String?
  status        VideoReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Same reasoning as VideoReport: one report per user per LIVE session,
  // enforced at the database level.
  @@unique([liveSessionId, reporterId])
  @@index([liveSessionId])
  @@index([status])
  @@map("live_reports")
}

// Reporting a specific participant in a LIVE session (as distinct from
// reporting the session as a whole, which LiveReport already covers).
model LiveViewerReport {
  id String @id @default(uuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  reportedUserId String
  reportedUser   User   @relation("LiveViewerReportTarget", fields: [reportedUserId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("LiveViewerReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reason      VideoReportReason
  description String?
  status      VideoReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([liveSessionId, reportedUserId, reporterId])
  @@index([liveSessionId])
  @@map("live_viewer_reports")
}

// Reporting a specific LIVE chat message.
model LiveChatMessageReport {
  id String @id @default(uuid())

  liveChatMessageId String
  liveChatMessage   LiveChatMessage @relation(fields: [liveChatMessageId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  reason      VideoReportReason
  description String?
  status      VideoReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([liveChatMessageId, reporterId])
  @@map("live_chat_message_reports")
}

// LIVE scheduling ("LIVE events") — a creator announces an upcoming LIVE so
// followers can discover it and set a reminder ahead of time. Starting the
// event creates/attaches a real LiveSession; this model itself never
// carries stream media.
enum LiveEventStatus {
  SCHEDULED
  STARTED
  CANCELLED
}

model LiveEvent {
  id String @id @default(uuid())

  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    String?
  scheduledAt DateTime

  status LiveEventStatus @default(SCHEDULED)

  liveSessionId String?      @unique
  liveSession   LiveSession? @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders LiveEventReminder[]

  @@index([status, scheduledAt])
  @@index([hostId])
  @@map("live_events")
}

// A follower asking to be reminded when a scheduled LIVE starts. Step 4
// only records the request — actual push/notification delivery is a later
// step's notification-fan-out infrastructure (see docs/STEP4_PROGRESS.md).
model LiveEventReminder {
  id String @id @default(uuid())

  liveEventId String
  liveEvent   LiveEvent @relation(fields: [liveEventId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([liveEventId, userId])
  @@map("live_event_reminders")
}

// Host-appointed moderators for a specific LIVE session — grants
// mute/block/remove-comment authority without granting host-only powers
// (ending the LIVE, managing guests).
model LiveModerator {
  id String @id @default(uuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedById String

  createdAt DateTime @default(now())

  @@unique([liveSessionId, userId])
  @@index([liveSessionId])
  @@map("live_moderators")
}

// Per-session mute (can watch, can't chat) / block (can't rejoin at all)
// applied by the host or a moderator.
enum LiveRestrictionType {
  MUTED
  BLOCKED
}

model LiveViewerRestriction {
  id String @id @default(uuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  type LiveRestrictionType

  createdById String

  createdAt DateTime @default(now())

  @@unique([liveSessionId, userId, type])
  @@index([liveSessionId])
  @@map("live_viewer_restrictions")
}

// Server-side keyword filter for LIVE chat — admin-managed, checked before
// a chat message is ever persisted (see routes/v1/live.ts).
model LiveBlockedWord {
  id   String @id @default(uuid())
  word String @unique

  createdAt DateTime @default(now())

  @@map("live_blocked_words")
}

// Unifies co-host (role: CO_HOST) and multi-guest (role: GUEST) into one
// scalable participant model — LiveSession.maxGuestSlots is the only thing
// that changes between "one co-host" and "multiple guests," not the schema.
enum LiveGuestRole {
  CO_HOST
  GUEST
}

enum LiveGuestStatus {
  INVITED
  ACTIVE
  DECLINED
  REMOVED
  LEFT
}

model LiveGuestSlot {
  id String @id @default(uuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   LiveGuestRole   @default(GUEST)
  status LiveGuestStatus @default(INVITED)

  invitedById String

  respondedAt DateTime?
  joinedAt    DateTime?
  leftAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([liveSessionId, userId])
  @@index([liveSessionId, status])
  @@map("live_guest_slots")
}

// LIVE Match / Battle — pairs two hosts' own LiveSessions against each
// other. Deliberately has no Coins/Gifts fields yet; viewer "support" for a
// side and score contribution are a later step's concern once Coins/Gifts
// exist (see docs/STEP4_PROGRESS.md for the planned event-interface hook).
enum LiveMatchStatus {
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

model LiveMatch {
  id String @id @default(uuid())

  sessionAId String
  sessionA   LiveSession @relation("MatchSessionA", fields: [sessionAId], references: [id], onDelete: Cascade)
  sessionBId String
  sessionB   LiveSession @relation("MatchSessionB", fields: [sessionBId], references: [id], onDelete: Cascade)

  status LiveMatchStatus @default(PENDING)

  scoreA Int @default(0)
  scoreB Int @default(0)

  winnerSessionId String?
  durationSeconds Int     @default(180)

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("live_matches")
}

// Fan/subscriber foundation — deliberately has no payment/billing fields.
// Nothing in Step 4 can ever set status to ACTIVE outside of tests, since
// the subscription-purchase flow is a later monetization step; the model
// and its enforcement hook (LiveSession.subscriberOnlyChat) exist now so
// that step can plug in without a schema change.
enum LiveSubscriptionStatus {
  ACTIVE
  CANCELLED
}

model LiveSubscription {
  id String @id @default(uuid())

  creatorId String
  creator   User   @relation("CreatorSubscriptions", fields: [creatorId], references: [id], onDelete: Cascade)
  fanId     String
  fan       User   @relation("FanSubscriptions", fields: [fanId], references: [id], onDelete: Cascade)

  status LiveSubscriptionStatus @default(ACTIVE)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@unique([creatorId, fanId])
  @@index([creatorId])
  @@map("live_subscriptions")
}

// ---------------------------------------------------------------------------
// Chat + Voice/Video Calls (Step 5)
// ---------------------------------------------------------------------------

// A conversation request the recipient hasn't accepted yet (their privacy
// setting didn't allow the sender through automatically) vs. a normal,
// mutually-visible conversation. See lib/messagingAccess.ts for the
// eligibility logic that decides which one a new conversation starts as.
enum ConversationRequestStatus {
  PENDING
  ACCEPTED
}

// One row per ordered pair of users — `participantOneId`/`participantTwoId`
// are always stored with the lexicographically smaller user id first
// (normalized by lib/messagingAccess.ts), which is what makes "find or
// create the 1:1 conversation between these two users" a single unique-index
// lookup instead of an OR-of-two-orderings query.
model Conversation {
  id String @id @default(uuid())

  participantOneId String
  participantOne   User   @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwoId String
  participantTwo   User   @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)

  initiatedById String
  initiatedBy   User   @relation("ConversationInitiator", fields: [initiatedById], references: [id], onDelete: Cascade)

  status ConversationRequestStatus @default(ACCEPTED)

  // Denormalized pointers to the latest message, maintained transactionally
  // whenever a message is sent — lets the conversation list sort/paginate by
  // recency without a correlated MAX(createdAt) subquery per conversation.
  lastMessageId String?   @unique
  lastMessage   Message?  @relation("ConversationLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]                 @relation("ConversationMessages")
  reports      ConversationReport[]

  @@unique([participantOneId, participantTwoId])
  @@index([participantOneId, status, lastMessageAt])
  @@index([participantTwoId, status, lastMessageAt])
  @@map("conversations")
}

// Per-user mutable state for a conversation (unread count, mute, pin, read
// cursor) — kept off `Conversation` itself because it differs per side (my
// unread count is not your unread count).
model ConversationParticipant {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  unreadCount       Int       @default(0)
  lastReadAt        DateTime?
  lastReadMessageId String?

  muted    Boolean   @default(false)
  pinned   Boolean   @default(false)
  pinnedAt DateTime?

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId, pinned])
  @@map("conversation_participants")
}

enum MessageType {
  TEXT
  VOICE
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  type MessageType @default(TEXT)
  text String?

  // Voice message fields (see lib/voiceValidation.ts) — populated only when
  // type is VOICE. Real duration comes from ffprobe on the uploaded file,
  // never the client's claimed value.
  voiceKey        String?
  voiceDurationMs Int?
  voiceMimeType   String?

  // Client-generated idempotency key: retrying the same logical send (e.g.
  // after a dropped response on a flaky connection) with the same key
  // returns the already-created message instead of creating a duplicate —
  // enforced by the database, not just application logic.
  clientMessageId String

  // Unsend/delete: a tombstone, not a hard delete — the row (and its place
  // in message ordering) stays; readers see "message deleted" instead of
  // whatever it said. See routes/v1/messages.ts for the policy (sender-only,
  // time-limited).
  deletedAt DateTime?

  createdAt DateTime @default(now())

  receipts      MessageReceipt[]
  reports       MessageReport[]
  asLastMessage Conversation?    @relation("ConversationLastMessage")

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// Delivery/read tracking per recipient. In a 1:1 conversation there is only
// ever one recipient row per message, but keeping it per-user (rather than a
// single status enum on Message) means group messaging is a later step's
// schema no-op, not a rewrite.
model MessageReceipt {
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveredAt DateTime?
  readAt      DateTime?

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_receipts")
}

model MessageReport {
  id String @id @default(uuid())

  messageId   String
  message     Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason      VideoReportReason
  description String?
  status      VideoReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([messageId, reporterId])
  @@index([messageId])
  @@index([status])
  @@map("message_reports")
}

model ConversationReport {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason         VideoReportReason
  description    String?
  status         VideoReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([conversationId, reporterId])
  @@index([conversationId])
  @@index([status])
  @@map("conversation_reports")
}

// Blocking is directional (A blocking B doesn't imply B blocked A), but
// lib/messagingAccess.ts treats a block in *either* direction as mutual for
// messaging/call purposes — the simplest rule that matches "a blocked
// relationship should stop contact both ways," and avoids the awkward case
// of someone still being able to call/message a person they themselves blocked.
model UserBlock {
  id String @id @default(uuid())

  blockerId String
  blocker   User   @relation("BlockedByMe", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("BlockedAgainstMe", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

// "Who can message me" — checked when a NEW conversation is created, not on
// every message (an existing ACCEPTED conversation stays usable even if the
// owner tightens this setting later; it only gates new contact, matching the
// reference product's behavior).
enum MessagePermission {
  EVERYONE
  MUTUAL_FOLLOWERS
  NO_ONE
}

model MessagingPrivacySettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  whoCanMessage      MessagePermission @default(MUTUAL_FOLLOWERS)
  showActivityStatus Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("messaging_privacy_settings")
}

enum CallStatus {
  RINGING
  ACCEPTED
  DECLINED
  BUSY
  MISSED
  ENDED
  CANCELLED
  FAILED
}

model Call {
  id String @id @default(uuid())

  callerId String
  caller   User   @relation("CallsAsCaller", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId String
  callee   User   @relation("CallsAsCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  status CallStatus @default(RINGING)

  // The LiveKit room backing this call's real WebRTC media — same
  // LiveStreamingProvider abstraction Step 4 LIVE uses (lib/liveStreaming.ts).
  roomName String

  startedAt       DateTime  @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  failureReason   String?

  reports CallReport[]

  @@index([callerId, startedAt])
  @@index([calleeId, startedAt])
  @@index([status])
  @@map("calls")
}

model CallReport {
  id String @id @default(uuid())

  callId      String
  call        Call              @relation(fields: [callId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason      VideoReportReason
  description String?
  status      VideoReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([callId, reporterId])
  @@index([callId])
  @@index([status])
  @@map("call_reports")
}

// ---------------------------------------------------------------------------
// TikTok-parity social + creation features (Step 6)
// ---------------------------------------------------------------------------

// Normalized (lowercase, no leading #) so #XNAKView and #xnakview are the
// same row — normalization happens in lib/hashtags.ts before any query or
// write, never left to a DB collation trick.
model Hashtag {
  id        String   @id @default(uuid())
  tag       String   @unique
  postCount Int      @default(0)
  createdAt DateTime @default(now())

  videos     VideoHashtag[]
  photoPosts PhotoPostHashtag[]
  textPosts  TextPostHashtag[]

  @@index([postCount])
  @@map("hashtags")
}

model VideoHashtag {
  id String @id @default(uuid())

  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([videoId, hashtagId])
  @@index([hashtagId, createdAt])
  @@map("video_hashtags")
}

// Extracted from a caption server-side at post time (lib/hashtags.ts) and
// resolved against real usernames — never trusted from a client-supplied
// user id list, so a mention can only ever target an account that actually
// has that username.
model Mention {
  id String @id @default(uuid())

  videoId         String
  video           Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User   @relation("MentionsReceived", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  mentionedById   String
  mentionedBy     User   @relation("MentionsMade", fields: [mentionedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([videoId, mentionedUserId])
  @@index([mentionedUserId, createdAt])
  @@map("mentions")
}

// References the original video, never duplicates the media (brief H).
model Repost {
  id String @id @default(uuid())

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([userId, createdAt])
  @@index([videoId])
  @@map("reposts")
}

// TikTok's "Favorites" (brief I) — private by default and, today, the only
// visibility this has: there is no sharing/public-favorites surface.
model Favorite {
  id String @id @default(uuid())

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([userId, createdAt])
  @@map("favorites")
}

enum ActivityType {
  LIKE
  COMMENT
  COMMENT_LIKE
  COMMENT_REPLY
  FOLLOW
  MENTION
  REPOST
}

// The persisted in-app Activity tab (brief O) — distinct from
// lib/notifications.ts's NotificationDispatcher, which is an ephemeral
// "ring/message right now" push onto the realtime gateway for messages and
// calls. This is a durable, paginated, read/unread log of social activity.
model ActivityNotification {
  id String @id @default(uuid())

  recipientId String
  recipient   User          @relation("ActivityRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User          @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  type        ActivityType
  videoId     String?
  video       Video?        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     VideoComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("activity_notifications")
}

// One row per (user, query) — a repeat search bumps createdAt via upsert
// rather than growing an unbounded history of duplicates.
model RecentSearch {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  query  String

  createdAt DateTime @default(now())

  @@unique([userId, query])
  @@index([userId, createdAt])
  @@map("recent_searches")
}

// Locked behind a follower-count gate (see env.CREATOR_PLAYLIST_MIN_FOLLOWERS,
// default 5000) enforced in routes/v1/playlists.ts — never by hiding the
// button client-side. Falling back below the threshold later preserves
// existing playlists (brief N's explicit downgrade policy); only creating
// new ones / adding videos is re-gated.
model CreatorPlaylist {
  id String @id @default(uuid())

  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverKey    String?
  viewCount   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CreatorPlaylistItem[]

  @@index([userId, createdAt])
  @@map("creator_playlists")
}

model CreatorPlaylistItem {
  id String @id @default(uuid())

  playlistId String
  playlist   CreatorPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  videoId    String
  video      Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  position   Int

  createdAt DateTime @default(now())

  @@unique([playlistId, videoId])
  @@unique([playlistId, position])
  @@index([playlistId, position])
  @@map("creator_playlist_items")
}

// ---------------------------------------------------------------------------
// Sounds foundation (Step 6, brief C) — never a bundled copyrighted catalog.
// Every video's own audio is implicitly usable as a Sound; a Sound row only
// gets created lazily the first time it's actually reused by a second video
// (see lib/sounds.ts) or browsed as a page, not eagerly for every upload.
// ---------------------------------------------------------------------------

model Sound {
  id String @id @default(uuid())

  // The video this audio was originally extracted from — attribution
  // (brief C) always traces back here, never to whoever most recently used it.
  sourceVideoId String @unique
  sourceVideo   Video  @relation("SoundSource", fields: [sourceVideoId], references: [id], onDelete: Cascade)

  title      String?
  usageCount Int      @default(1)
  createdAt  DateTime @default(now())

  usedByVideos Video[] @relation("VideosUsingSound")

  @@index([usageCount])
  @@map("sounds")
}

// ---------------------------------------------------------------------------
// Photo posts / carousels (Step 6, brief A) — 2-35 swipeable images
// (TikTok's current Photo Mode), a separate content type from Video rather
// than a Video with an image "playback" — no transcoding pipeline applies,
// so it doesn't share Video's PROCESSING/FAILED lifecycle. Comments here are
// intentionally flat (no reply/pin threading) — a bounded v1 of the
// engagement surface Video already has in full; see docs/STEP6_PROGRESS.md.
// ---------------------------------------------------------------------------

model PhotoPost {
  id String @id @default(uuid())

  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  caption       String?
  visibility    VideoVisibility @default(PUBLIC)
  allowDownload Boolean         @default(true)

  likeCount    Int @default(0)
  commentCount Int @default(0)
  viewCount    Int @default(0)
  shareCount   Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  photos   PhotoPostAsset[]
  likes    PhotoPostLike[]
  comments PhotoPostComment[]
  reports  PhotoPostReport[]
  hashtags PhotoPostHashtag[]

  @@index([userId, createdAt])
  @@index([visibility, createdAt])
  @@map("photo_posts")
}

model PhotoPostAsset {
  id String @id @default(uuid())

  photoPostId String
  photoPost   PhotoPost @relation(fields: [photoPostId], references: [id], onDelete: Cascade)
  key         String
  position    Int

  @@unique([photoPostId, position])
  @@map("photo_post_assets")
}

model PhotoPostLike {
  id String @id @default(uuid())

  photoPostId String
  photoPost   PhotoPost @relation(fields: [photoPostId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([photoPostId, userId])
  @@index([userId])
  @@map("photo_post_likes")
}

model PhotoPostComment {
  id String @id @default(uuid())

  photoPostId String
  photoPost   PhotoPost @relation(fields: [photoPostId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String

  createdAt DateTime @default(now())

  @@index([photoPostId, createdAt])
  @@map("photo_post_comments")
}

model PhotoPostReport {
  id String @id @default(uuid())

  photoPostId String
  photoPost   PhotoPost         @relation(fields: [photoPostId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason      VideoReportReason
  description String?
  status      VideoReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([photoPostId, reporterId])
  @@index([status])
  @@map("photo_post_reports")
}

model PhotoPostHashtag {
  id String @id @default(uuid())

  photoPostId String
  photoPost   PhotoPost @relation(fields: [photoPostId], references: [id], onDelete: Cascade)
  hashtagId   String
  hashtag     Hashtag   @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([photoPostId, hashtagId])
  @@index([hashtagId, createdAt])
  @@map("photo_post_hashtags")
}

// ---------------------------------------------------------------------------
// Text posts (Step 6, brief B) — same bounded engagement posture as
// PhotoPost above (flat comments, no reply/pin).
// ---------------------------------------------------------------------------

model TextPost {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  text   String

  // A named preset (e.g. "gradient-1"), never free-form styling data —
  // matches "do not store presentation-only client data unnecessarily"
  // (brief §3) while still letting the client render a background.
  backgroundStyle String?
  visibility      VideoVisibility @default(PUBLIC)

  likeCount    Int @default(0)
  commentCount Int @default(0)
  viewCount    Int @default(0)
  shareCount   Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  likes    TextPostLike[]
  comments TextPostComment[]
  reports  TextPostReport[]
  hashtags TextPostHashtag[]

  @@index([userId, createdAt])
  @@index([visibility, createdAt])
  @@map("text_posts")
}

model TextPostLike {
  id String @id @default(uuid())

  textPostId String
  textPost   TextPost @relation(fields: [textPostId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([textPostId, userId])
  @@index([userId])
  @@map("text_post_likes")
}

model TextPostComment {
  id String @id @default(uuid())

  textPostId String
  textPost   TextPost @relation(fields: [textPostId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String

  createdAt DateTime @default(now())

  @@index([textPostId, createdAt])
  @@map("text_post_comments")
}

model TextPostReport {
  id String @id @default(uuid())

  textPostId  String
  textPost    TextPost          @relation(fields: [textPostId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason      VideoReportReason
  description String?
  status      VideoReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([textPostId, reporterId])
  @@index([status])
  @@map("text_post_reports")
}

model TextPostHashtag {
  id String @id @default(uuid())

  textPostId String
  textPost   TextPost @relation(fields: [textPostId], references: [id], onDelete: Cascade)
  hashtagId  String
  hashtag    Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([textPostId, hashtagId])
  @@index([hashtagId, createdAt])
  @@map("text_post_hashtags")
}

// ---------------------------------------------------------------------------
// Stories (Step 6, brief D) — `expiresAt` is set once, at creation
// (createdAt + 24h), and every read query filters on it server-side
// (`expiresAt: { gt: now }`); the client's clock is never trusted for
// expiration (brief's explicit "server/database must be authoritative"
// requirement). Replies are comment-like and visible to the story owner —
// current TikTok's actual mechanic (comments that disappear with the
// story), not a Step 5 DM.
// ---------------------------------------------------------------------------

enum StoryMediaType {
  PHOTO
  VIDEO
}

model Story {
  id String @id @default(uuid())

  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaKey  String
  mediaType StoryMediaType
  caption   String?

  viewCount  Int @default(0)
  replyCount Int @default(0)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  deletedAt DateTime?

  views   StoryView[]
  replies StoryReply[]
  reports StoryReport[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  id String @id @default(uuid())

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
  @@map("story_views")
}

model StoryReply {
  id String @id @default(uuid())

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  text    String

  createdAt DateTime @default(now())

  @@index([storyId, createdAt])
  @@map("story_replies")
}

model StoryReport {
  id String @id @default(uuid())

  storyId     String
  story       Story             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason      VideoReportReason
  description String?
  status      VideoReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([storyId, reporterId])
  @@index([status])
  @@map("story_reports")
}
